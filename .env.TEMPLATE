# SQL comparer environment template.
# Copy this file to .env or another private location, then provide it to cfct.sh with CFCT_ENV_FILE.
# Do not commit real production credentials.
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.microsoft.sqlserver.jdbc.SQLServerDriver
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password
CFCT_LEFT_DATABASE=left_database
CFCT_RIGHT_DATABASE=right_database
